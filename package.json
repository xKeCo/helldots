{
  "name": "helldots",
  "version": "1.0.0",
  "description": "Comment overlay library for web applications",
  "main": "dist/helldots.esm.js",
  "module": "dist/helldots.esm.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/helldots.esm.js",
      "default": "./dist/helldots.esm.js"
    }
  },
  "unpkg": "dist/helldots.umd.js",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "size": "node scripts/check-size.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
